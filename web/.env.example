# web/.env.local (로컬) 또는 Vercel 프로젝트 환경변수에 넣는다. 이 파일에는 실제 값을 넣지 않는다.

# DB — Supabase: Project Settings → Database → Connection string → "Transaction pooler"(포트 6543)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_MAX=5

# 세션 쿠키 서명 키(아무 긴 무작위 문자열)
SBN_SECRET=
# 자격증명(Redmine · 메일 비밀번호) 암호화 키 — 예전 앱과 같은 값이어야 옮겨 온 자격증명이 풀린다
FERNET_KEY=

# Claude
ANTHROPIC_API_KEY=
SB_MODEL=claude-opus-5-5
# LLM Wiki 모델(비우면 claude-haiku-5-5). SB 초안 모델과 따로 정한다.
WIKI_MODEL=claude-haiku-5-5
SB_EFFORT=medium

# 메일 발송 — 로그인은 공용 계정 하나(TW_MAIL_ACCOUNT), 보이는 발신자는 시스템 주소
TW_MAIL_ACCOUNT=
TW_MAIL_FROM=
TW_MAIL_FROM_NAME=TA FAQ
TW_MAIL_REPLY_TO=
TW_MAIL_ALWAYS_CC=
USER_SMTP_PORT=587
# 메일 본문에 싣는 이 앱의 주소
TW_APP_URL=https://<배포 주소>

# 0 = 검증 모드(메일을 보내지 않고 기록만), 1 = 운영. 화면 [설정 → 검증 모드]에서 바꾼 값이 이긴다.
TWN_LIVE_WRITES=0

# 5분 주기 작업(/api/cron/tick)을 부를 때 쓰는 비밀값 — Supabase Cron(npm run db:cron)이 Authorization: Bearer 로 보낸다
CRON_SECRET=

# 이관 스크립트(npm run db:migrate)에서만 — 예전 FastAPI 앱의 DB(sbnext)
# SOURCE_DATABASE_URL=postgresql://sbn:<password>@127.0.0.1:5432/sbnext
